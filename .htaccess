# Ensure the Authorization (Bearer token) header reaches PHP.
# Required on Apache mod_rewrite / FastCGI setups (common on free hosts).
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

Options -Indexes

# ---- MAINTENANCE MODE ----
# Toggle: upload a file named `.maintenance` into the site root (public_html)
# to show maintenance.html; delete it to go live again.
# (maintenance.html lives next to this file; assets/api stay reachable for the page.)
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/maintenance\.html$
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
RewriteRule ^(.*)$ /maintenance.html [R=302,L]

# Serve Android APK with the correct MIME type and force download.
<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.apk$">
    Header set Content-Type "application/vnd.android.package-archive"
    Header set Content-Disposition "attachment; filename=sbc-mobile.apk"
  </FilesMatch>
  <FilesMatch "version\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Content-Type "application/json; charset=utf-8"
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>